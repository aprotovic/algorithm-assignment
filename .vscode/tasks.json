{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build Broker System",
            "command": "g++",
            "args": [
                "-g",
                "${workspaceFolder}\\src\\*.cpp",
                "-o",
                "${workspaceFolder}\\BrokerSystem.exe",
                "-lgdi32",
                "-lgdiplus",
                "-lcomdlg32",
                "-lshell32",
                "-lwininet",
                "-static-libgcc",
                "-static-libstdc++"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build the entire project using g++"
        }
    ]
}
